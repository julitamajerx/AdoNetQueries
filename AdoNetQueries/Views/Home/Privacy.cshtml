@{
    ViewData["Title"] = "Dodaj";
}
<h1>@ViewData["Title"]</h1>

<form method="post" class="student-form" asp-action="Dodaj">
    <label for="imie">Imie</label>
    <input type="text" id="imie" name="imie" required/>

    <label for="nazwisko">Nazwisko</label>
    <input type="text" id="nazwisko" name="nazwisko" required/>

    <label for="data_urodzenia">Data urodzenia</label>
    <input type="date" id="data_urodzenia" name="data_urodzenia" required/>

    <label for="miasto">Miasto</label>
    <input type="text" id="miasto" name="miasto"/>

    <label for="rok_studiow">Rok studiów</label>
    <input type="number" id="rok_studiow" name="rok_studiow" min="1" max="5" required />

    <button type="submit"> Zapisz </button>
</form>